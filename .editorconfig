root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json,mjs,js,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Built sample apps are kept byte for byte as the build script wrote them.
[Fixtures/apps/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
